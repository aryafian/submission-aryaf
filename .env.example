# ── App ──────────────────────────────────────────────
TZ=Asia/Jakarta
HOSTNAME=0.0.0.0
APP_URL=http://localhost:3003
COOKIE_SECURE=false

# ── Database ─────────────────────────────────────────
# DB_DIALECT=postgresql (default) or mysql
DB_DIALECT=mysql
POSTGRES_URL=postgresql://postgres:password@localhost:5432/db_skeleton
MYSQL_URL=mysql://root:password@localhost:3306/db_skeleton

# ── Auth ─────────────────────────────────────────────
# local = login via username/password in Postgres (default)
# sso   = verify JWT from external SSO Portal
AUTH_MODE=local

AUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_SECRET=change-me-to-a-random-secret
AUTH_URL=http://localhost:3003
NEXTAUTH_URL=http://localhost:3003

# ── Logging ─────────────────────────────────────────
LOG_LEVEL=info

# ── SSO Portal (only needed if AUTH_MODE=sso) ───────
# SSO_PORTAL_URL=http://localhost:3010
# SSO_PORTAL_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
